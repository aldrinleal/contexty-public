# AssemblyAI API key (https://www.assemblyai.com/app/account).
# The CLI refuses to start without it, even though it's only *used* when a
# video has no subtitles of its own (see README.md "Limitations").
ASSEMBLYAI_API_KEY=

# Where data-[ID]/ folders are written ("." = current directory).
CONTEXTY_OUTPUT_DIR=.

# sqlite file backing the dedup guard + job history (app/jobstore.py).
CONTEXTY_DB_PATH=contexty.db

# Bearer token required on every app/api.py request except /healthz.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CONTEXTY_API_TOKEN=

# uvicorn bind host/port for `make api`.
CONTEXTY_HOST=127.0.0.1
CONTEXTY_PORT=8000

# Thread pool size for background job execution (app/api.py).
CONTEXTY_MAX_WORKERS=2

# Default audio container yt-dlp/ffmpeg extracts to.
CONTEXTY_YTDLP_AUDIO_FORMAT=m4a

# Force a transcript language (ISO 639-1, e.g. "pt", "en"). Leave unset for
# AssemblyAI auto-detect / native-subtitle auto-select.
CONTEXTY_TRANSCRIPT_LANGUAGE=

# Try the source's own subtitles (yt-dlp) before falling back to AssemblyAI.
CONTEXTY_PREFER_NATIVE_SUBTITLES=true

# Enable AssemblyAI speaker diarization (only applies on the AssemblyAI path).
CONTEXTY_DIARIZATION=true

# Timeout (seconds) for every yt-dlp/ffmpeg/ffprobe subprocess call.
CONTEXTY_FFMPEG_TIMEOUT_S=120

# How often (seconds) the pipeline's internal poll loop checks AssemblyAI.
CONTEXTY_POLL_INTERVAL_S=30

# 24h TTL dedup guard + job history, backed by the local sqlite file above.
# Set to false to disable entirely (no contexty.db is created).
CONTEXTY_ENABLE_HISTORY_GUARD=true

# --- YouTube cookies (bot-check workaround, optional) ------------------------
# Netscape-format cookies.txt passed to yt-dlp, or a local browser name to
# read cookies from directly (chrome, firefox, edge, brave, safari, ...).
# Leave commented out unless needed (an empty value is not the same as unset).
# CONTEXTY_COOKIES_FILE=cookies.txt
# CONTEXTY_COOKIES_FROM_BROWSER=firefox

# --- Optional S3 copy of every finished job (off by default) -----------------
# Needs the AWS CLI credentials in the environment (AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION) and a bucket you own.
CONTEXTY_ENABLE_S3_SYNC=false
# CONTEXTY_S3_BUCKET=your-bucket-name
